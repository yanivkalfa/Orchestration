# The lane's outputs (requests, results, logs) are local, not history.
lane/done/*
!lane/done/.gitkeep
lane/queue/*
!lane/queue/.gitkeep
lane/lane.log
lane/.lock/

# Hook state
.claude/.lint-seen
.claude/settings.local.json


# project/commands.env — the commands the hooks and the lane read.
# KEY=value, one per line, no quotes needed, no spaces around '='.
# An EMPTY value makes the matching hook a safe no-op.
# Placeholders: {module} is a module name, {file} is an edited file path.
# Example values (Kotlin mobile app) are in comments — example, replace.

# Static checks for one module, warnings as errors.
# example: ./gradlew :{module}:lint :{module}:detekt
LINT_CMD=

# Tests for one module.
# example: ./gradlew :{module}:testDebugUnitTest
TEST_CMD=

# Format ONE edited file (run by the PostToolUse hook).
# example: ktlint -F {file}
FORMAT_CMD=

# Lint run at turn end by the Stop hook when source files changed (fast, whole tree).
# example: ktlint
STOP_LINT_CMD=

# The heavy build. Only the lane runs it.
# example: ./gradlew assembleDebug
BUILD_CMD=

# The full periodic gate.
# example: ./gradlew check
GATE_CMD=

# Extended regex of program names the PreToolUse guard refuses when run directly.
# example: gradlew|gradle
GUARD_PROGRAMS=

# Extended regex of source-file extensions the Stop hook watches.
# example: kt|kts
SOURCE_EXT=
